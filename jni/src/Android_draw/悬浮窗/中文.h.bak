void ImGuiLayout3() {
ImGui::Spacing();//间距
ImGui::Spacing();//间距
ImGui::Spacing();//间距
ImGui::Checkbox("触摸自瞄", &Config.自动瞄准.自瞄开关);
ImGui::SameLine();	
ImGui::Checkbox("调整触摸位置", &Config.自动瞄准.触摸位置);


ImGui::Checkbox("隐藏范围", &Config.自动瞄准.隐藏范围);
ImGui::SameLine();	
ImGui::Checkbox("音量快捷", &Config.自动瞄准.音量快捷);


ImGui::Text("自瞄范围");
ImGui::SameLine(ImGui::GetCursorPosX() + 520);
ImGui::Text("%.0f", Config.自动瞄准.自瞄范围);
ImGui::SliderFloat("", &Config.自动瞄准.自瞄范围, 10.0f, 1200.0f);


if (ImGui::Button("获取开火键",{-1,80})) {
}
if (ImGui::Button("获取开境键",{-1,80})) {
}


ImGui::Checkbox("锁定模式", &Config.自动瞄准.持续锁定);
ImGui::SameLine();
ImGui::Checkbox("忽略倒地", &Config.自动瞄准.忽略倒地);	
ImGui::SameLine();	
ImGui::Checkbox("忽略人机", &Config.自动瞄准.忽略人机);


ImGui::Combo("触发条件", &条件, "开火\0开镜\0开火/开镜\0",4);
    switch (条件) {
     case 0:
    Config.自动瞄准.优先方式 = 0.0f;
    break;
    case 1:
    Config.自动瞄准.优先方式 = 1.0f;
    break;
    case 2:
    Config.自动瞄准.优先方式 = 2.0f;
    break;
    }
ImGui::Combo("优先方式", &部位, "头部\0胸部\0腹部\0",4);
    switch (部位) {
     case 0:
    Config.自动瞄准.瞄准部位 = 1.0f;
    break;
    case 1:
    Config.自动瞄准.瞄准部位 = 0.0f;
    break;
    case 2:
    Config.自动瞄准.瞄准部位 = 2.0f;
    break;
    }   
if (ImGui::CollapsingHeader("压枪配置")) {
ImGui::Text("压枪系数");
ImGui::SameLine(ImGui::GetCursorPosX() + 540);
ImGui::Text("%.1f", Config.自动瞄准.压枪参数);    
SliderFloat("压枪系数", &Config.自动瞄准.压枪参数, 0.10f, 5.00f, "%.1f");
    }
    

// 继续为其他参数添加 similar code...
if (ImGui::CollapsingHeader("基础设置")) {
ImGui::Text("自瞄速度");
ImGui::SameLine(ImGui::GetCursorPosX() + 550);
ImGui::Text("%.0f", Config.自动瞄准.瞄准速度);    
SliderFloat("自瞄速度", &Config.自动瞄准.瞄准速度, 0.1f, 50.0f, "%.0f");


ImGui::Text("滑屏系数");
ImGui::SameLine(ImGui::GetCursorPosX() + 530);
ImGui::Text("%.1f", Config.自动瞄准.锁定强度);    
SliderFloat("滑屏系数", &Config.自动瞄准.锁定强度, 0.1f, 30.0f, "%.1f");


ImGui::Text("线速度预判");
ImGui::SameLine(ImGui::GetCursorPosX() + 540);
ImGui::Text("%.1f", Config.自动瞄准.预判参数);       
SliderFloat("线速度预判", &Config.自动瞄准.预判参数, 0.0f, 5.0f, "%.1f");


ImGui::Text("子弹下坠预判");
ImGui::SameLine(ImGui::GetCursorPosX() + 540);
ImGui::Text("%.1f", Config.自动瞄准.子弹下坠预判);       
SliderFloat("子弹下坠预判", &Config.自动瞄准.子弹下坠预判, 0.00f, 3.00f, "%.1f");


ImGui::Text("自瞄距离");
ImGui::SameLine(ImGui::GetCursorPosX() + 530);
ImGui::Text("%.0f", Config.自动瞄准.自瞄距离);       
SliderFloat("自瞄距离", &Config.自动瞄准.自瞄距离, 0.0f, 600.0f, "%.0f");
}
}

void ImGuiLayout4() {
ImGui::Text("Dadar Settings;");
ImGui::RadioButton("CN", &Config.自动瞄准.语言, 0.0f);      
ImGui::SameLine();
ImGui::RadioButton("EN", &Config.自动瞄准.语言, 1.0f);
ImGui::Text("x");
ImGui::SameLine(ImGui::GetCursorPosX() + 530);
ImGui::Text("%.1f", Config.预警绘制.雷达X轴);       
SliderFloat("雷达X轴调整", &Config.预警绘制.雷达X轴, 0.0f, 1440.0f, "%0.1f");

ImGui::Text("y");
ImGui::SameLine(ImGui::GetCursorPosX() + 530);
ImGui::Text("%.1f", Config.预警绘制.雷达Y轴);       
SliderFloat("雷达Y轴调整", &Config.预警绘制.雷达Y轴, 0.0f, 3200.0f, "%0.1f");

ImGui::Text("RadarSize");
ImGui::SameLine(ImGui::GetCursorPosX() + 530);
ImGui::Text("%.1f", Config.预警绘制.雷达大小);       
SliderFloat("雷达大小调整", &Config.预警绘制.雷达大小, 50.0f, 500.0f, "%1.0f");
if (ImGui::Button("重置配置(自动重启)", {-1, 60}))
{
ImGuiMenustyle();
system("rm -rf /data/local/tests/unrestricted/小韩配置");
system("rm -rf /data/local/tests/unrestricted/小韩配置文件");
exit(0);
}
