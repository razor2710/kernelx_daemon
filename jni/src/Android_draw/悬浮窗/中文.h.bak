
//UI
bool Tabb, interface3, isDown, isTe;
void tick() {
ImGuiIO& io = ImGui::GetIO();
static ImVec4 clear_color = ImVec4(147,189,64,255);

ImGuiStyle &style = ImGui::GetStyle();
//UI

style.Colors[ImGuiCol_Text] = ImColor(255, 255, 255, 255);//字体颜色
style.Colors[ImGuiCol_WindowBg] = ImColor(0, 0, 0);//背景色	
style.Colors[ImGuiCol_Button] = ImColor(147,189,64,255);//按钮颜色
style.Colors[ImGuiCol_ButtonHovered] = ImColor(147,189,64,255);//按钮点击后悬停颜色
style.Colors[ImGuiCol_ButtonActive] = ImColor(147,189,64,255);//按钮点击颜色
style.Colors[ImGuiCol_FrameBg] = ImColor(147,189,64,150);//控件内背景色
style.Colors[ImGuiCol_FrameBgActive] = ImColor(147,189,64,160);//控件内点击背景色
style.Colors[ImGuiCol_FrameBgHovered] = ImColor(147,189,64,160);//控件内点击后悬停背景色
style.Colors[ImGuiCol_CheckMark] = ImColor(147,189,64,255);//控件Check勾子颜色	
style.Colors[ImGuiCol_SliderGrab] = ImColor(147,189,64,255);
style.Colors[ImGuiCol_SliderGrabActive] = ImColor(147,189,64,255);	
style.Colors[ImGuiCol_Header] = ImColor(147,189,64,255);
style.Colors[ImGuiCol_HeaderHovered] = ImColor(147,189,64,255);
style.Colors[ImGuiCol_HeaderActive] = ImColor(147,189,64,255);
style.Colors[ImGuiCol_ScrollbarBg] = ImColor(42,42,42,225);//滑动条背景颜色
style.Colors[ImGuiCol_ScrollbarGrab] = ImColor(147,189,64,255);//滑动条颜色
style.Colors[ImGuiCol_ScrollbarGrabHovered] = ImColor(147,189,64,255);//滚动条点击后悬停
style.Colors[ImGuiCol_ScrollbarGrabActive] = ImColor(147,189,64,255);//滑动条点击	
style.Colors[ImGuiCol_Separator] = ImColor(147,189,64,255);

style.Colors[ImGuiCol_ResizeGrip] = ImColor(147,189,64,255); // 设置为红色
style.Colors[ImGuiCol_ResizeGripHovered] = ImColor(147,189,64,255); // 设置为红色
style.Colors[ImGuiCol_ResizeGripActive] = ImColor(147,189,64,255); // 设置为红色




style.GrabRounding = 5.0f;
style.GrabMinSize = 35.0f;

style.FrameRounding = 5.0f;
style.FrameBorderSize = 0.5f;
style.FramePadding = ImVec2(5, 8);//悬浮窗

style.ScrollbarSize = 35.0f;
style.ScrollbarRounding = 5.0f;

style.WindowBorderSize = 0.0f;
style.WindowTitleAlign = ImVec2(0.5, 0.5);

// ...之前的代码...

// 动画速度
static float ANIM_SPEED = 0.53f;
// 动画进度变量，IsBall为true时从0增加到1，IsBall为false时从1减少到0
static float Velua = IsBall ? 0.0f : 1.0f;
// 更新动画进度
Velua = ImClamp(Velua + (io.DeltaTime / ANIM_SPEED) * (IsBall ? 1.0f : -1.0f), 0.0f, 1.0f);

// 窗口的初始高度和起始宽度
float windowHeight = 550; // 高度保持不变
float windowWidth = 850 * Velua; // 宽度随动画进度变化

// 屏幕中间位置
float screenCenterX = screen_x / 2;
float screenCenterY = screen_y / 2;

// 窗口起始位置在屏幕中间，垂直方向
float startPosY = screenCenterY - windowHeight / 2;

// 如果IsBall为true，则窗口从中间向两边展开
if (IsBall) {
    // 计算起始位置的X坐标，使得窗口从中间开始展开
    float startPosX = screenCenterX - windowWidth / 2;
    // 设置窗口大小和位置
    ImGui::SetWindowSize("##MORISHIMA CHEAT", ImVec2(windowWidth, windowHeight));
    ImGui::SetWindowPos("##MORISHIMA CHEAT", ImVec2(startPosX, startPosY));
} else {
    // 如果IsBall为false，则窗口从两边向中间收缩
    // 计算目标位置的X坐标，即屏幕中间位置
    float targetPosX = screenCenterX - windowWidth / 2;
    // 设置窗口大小和位置，使用ImLerp进行插值计算位置
    ImGui::SetWindowSize("##MORISHIMA CHEAT", ImVec2(windowWidth, windowHeight));
    ImGui::SetWindowPos("##MORISHIMA CHEAT", ImVec2(ImLerp(screenCenterX, targetPosX, Velua), startPosY));
}

if (windowWidth <= 100 && !IsBall) {
    BallSwitch = true;
    MemuSwitch = false;
}

if (MemuSwitch) {
style.WindowRounding = 10.0f;


     
if (ImGui::Begin("##MORISHIMA CHEAT", &MemuSwitch,  ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoScrollbar)) {

auto Pos = ImGui::GetWindowPos();
Window = ImGui::GetCurrentWindow();
ImDrawList *draw_list = ImGui::GetWindowDrawList();



if (ImGui::BeginChild("##右菜单", ImVec2(625, 490), false)) {
ImGui::Spacing();//间距
ImGui::Spacing();//间距
ImGui::TextColored(ImColor(147,189,64,225), "Caesar.");
ImGui::Separator();
switch (MenuTab) {
case 1: {
ImGuiLayout1();
}
break;
case 2: {
ImGuiLayout2();
}
break;
case 3: {
ImGuiLayout3();
}
break;
case 4: {
ImGuiLayout4();
}
}
}

ImGui::EndChild();
ImGui::SameLine();
if (ImGui::BeginChild("##主菜单", ImVec2(150, -1), false, ImGuiWindowFlags_NoScrollbar)) {
auto Pos = ImGui::GetWindowPos();
DrawLogo({Pos.x + 83, Pos.y + 93}, 80);
ImGui::SetCursorPos({0, 180});
ImGui::Separator();//线
if (ImGui::Button("主页", ImVec2(150, 50))) {
MenuTab = 1;
}
if (ImGui::Button("绘制", ImVec2(150, 50))) {
MenuTab = 2;
}
if (ImGui::Button("自瞄", ImVec2(150, 50))) {
MenuTab = 3;
}
if (ImGui::Button("设置", ImVec2(150, 50))) {
MenuTab = 4;
}
if (ImGui::Button("缩小", ImVec2(150, 50))) {
IsBall = false;
}
}
}
}


if (IsWin) {
IsWin = false;
IsLoGin = false;
BallSwitch = false;
ImGui::SetWindowSize("Ball", {120.0f, 150.0f});
}
}



void ImGuiLayout1() {
ImGui::Spacing();//间距
ImGui::Spacing();//间距
if (链接驱动) {
ImGui::Button("重新载入", {-1,70});
链接驱动 = true;
} else {
if (ImGui::Button("载入游戏",{-1,70})) {
DrawInt();
链接驱动 = true;				
}
}
if (ImGui::Button("退出程序",{-1,70})) {
保存配置();
exit(0);
}
ImGui::Text("ApName:com.tencent.ig");

if (链接驱动 == true) {
ImGui::Separator();
ImGui::Text("libUE4.so: 0x%lX", 基址头);
ImGui::Text("PId: %d", 进程); 
ImGui::Text("UWorId: 0x%lX",Gname);
ImGui::Text("设备平均值 %.3f ms /帧率 %.1f FPS", 1000.0f / ImGui::GetIO().Framerate, ImGui::GetIO().Framerate); 
ImGui::Text("分辨率：%dx%d", screen_x,screen_y);
}
ImGui::Separator();
ImGui::Text("FPS");
ImGui::SameLine(ImGui::GetCursorPosX() + 530); // 假设530是你想要放置滑块的位置
ImGui::Text("%d", FPS); // 显示当前FPS值

// 创建整数滑块
if (ImGui::SliderInt("FPS", &FPS, 60, 144)) {
    // 如果滑块的值被改变，执行一些操作
}



ImGui::Checkbox("防录屏(需重启后生效)", &Config.自动瞄准.防录屏);
ImGui::Checkbox("无后台", &Config.人物绘制.无后台);
ImGui::Checkbox("性能模式", &Config.自动瞄准.性能模式);
ImGui::Checkbox("显示帧率", &Config.自动瞄准.显示帧率);
ImGui::Checkbox("备用触摸驱动(旧)", &Config.自动瞄准.触摸驱动);
}

